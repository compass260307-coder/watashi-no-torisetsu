# Disable advertising/analytics and keep login email in the local demo inbox.
NEXT_PUBLIC_DISABLE_THIRD_PARTY_MEASUREMENT=1
LOGIN_MAIL_MODE=preview

# Optional: Stripe sandbox/test mode only. The webhook secret is per listener.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
