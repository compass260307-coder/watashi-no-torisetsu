# Local Mac development only. Copy to .env.local; never commit real keys.
# See docs/TEAM_ENVIRONMENT.md. Blank credentials must come from the dev owner.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SUPABASE_URL=https://umhgnunxeupvxnrvatde.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
